// Configuration for odin-c-bindgen (https://github.com/karl-zylinski/odin-c-bindgen).
// Consumed by the "Generate bindings" GitHub Actions workflow, which checks out
// meshoptimizer into ./meshoptimizer before running the generator.
inputs = [
	"meshoptimizer/src"
]

output_folder = "meshopt"
package_name  = "meshopt"

remove_type_prefix     = "meshopt_"
remove_function_prefix = "meshopt_"
remove_macro_prefix    = "meshopt_"
required_prefix        = "meshopt_"

// Per-platform foreign import block (inlined at the top of the generated file).
// Using imports_file instead of import_lib so the same bindings work on
// Windows, Linux and macOS.
imports_file = "imports.odin"

// The simplification-options flags are an anonymous enum in meshoptimizer.h, so
// there is no type for rename/bit_setify to act on. Give it a name first, keyed
// by the C name of its first member.
deanon_enums = {
	"meshopt_SimplifyLockBorder" = "meshopt_SimplifyOptions"
}

rename = {
	"meshopt_EncodeExpMode"         = "Encode_Exp_Mode"
	"meshopt_VertexCacheStatistics" = "Vertex_Cache_Statistics"
	"meshopt_VertexFetchStatistics" = "Vertex_Fetch_Statistics"
	"meshopt_OverdrawStatistics"    = "Overdraw_Statistics"
	"meshopt_CoverageStatistics"    = "Coverage_Statistics"
	"meshopt_SimplifyOptions"       = "Simplify_Options"
}

bit_setify = {
	"meshopt_SimplifyOptions" = "Simplify_Options_Flags"
}

// bit_setify names the backing *enum* Simplify_Options_Flags; the renamed type
// Simplify_Options is the bit_set itself, which is what the procedures take.
procedure_type_overrides = {
	"meshopt_simplify.options"               = "Simplify_Options"
	"meshopt_simplifyWithAttributes.options" = "Simplify_Options"
	"meshopt_simplifyWithUpdate.options"     = "Simplify_Options"
}

remove_macros = [
	"MESHOPTIMIZER_API"
	"MESHOPTIMIZER_EXPERIMENTAL"
	"MESHOPTIMIZER_ALLOC_CALLCONV"
]
